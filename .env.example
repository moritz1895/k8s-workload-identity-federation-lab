# Copy to .env and adjust if needed. `docker compose` picks .env up automatically.

# Shared cluster secret for the single-node k3s server.
K3S_TOKEN=lab-not-a-secret-change-me

# Pinned k3s image.
K3S_IMAGE=rancher/k3s:v1.34.11-k3s1

# Identity the external validator expects and the port it is exposed on.
WIF_ISSUER=https://issuer-web
WIF_AUDIENCE=wif-demo-validator
VALIDATOR_HOST_PORT=18080
