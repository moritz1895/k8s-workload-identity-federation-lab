# Copy to .env and adjust if needed. `docker compose` picks .env up automatically.

# Shared cluster secret for the single-node k3s server.
K3S_TOKEN=lab-not-a-secret-change-me

# Pinned k3s image.
K3S_IMAGE=rancher/k3s:v1.34.11-k3s1

# Identity the external validator expects and the port it is exposed on.
WIF_ISSUER=https://issuer.wif.local
WIF_AUDIENCE=wif-demo-validator
VALIDATOR_HOST_PORT=18080

# Pinned nginx image (load-balancer and the Keycloak gateways).
NGINX_IMAGE=nginx:1.29-alpine

# Domain authorization server (Keycloak, realm domain-rst). Lab admin only — not a secret.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.2
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=lab-not-a-secret-change-me
KEYCLOAK_HOST_PORT=18443
KC_REALM_ISSUER=https://keycloak:8443/realms/domain-rst

# Resource server R: required audience and host port.
SERVICE_R_AUDIENCE=service-r
SERVICE_R_HOST_PORT=18081
